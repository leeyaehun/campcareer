# CampCareer — environment variables (copy to .env.local and fill in).
# Never commit real values. NEXT_PUBLIC_* are exposed to the browser; everything
# else is server-only and must NOT be referenced from client components.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS — server-only (visa-alert confirm/unsubscribe +
# broadcast worker). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct database connection for Supabase CLI migration workflows. Server-only;
# never expose it to the browser or use it in application request code.
SUPABASE_DB_URL=

# ── Email (Resend) — visa-alert send layer ──────────────────────────────────
# Resend API key for sending confirmation + policy-alert emails (server-only).
RESEND_API_KEY=
# Shared secret guarding POST /api/admin/broadcast (Authorization: Bearer ...).
# Server-only. Anyone with this can email the whole list — keep it secret.
ADMIN_BROADCAST_SECRET=
# Absolute site origin used to build email links, e.g. https://campcareer.com
NEXT_PUBLIC_SITE_URL=

# ── Optional measurement and search verification ───────────────────────────
# GA4 only loads after the visitor explicitly allows optional measurement.
# Leave blank in local/test environments to keep it disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-meta verification token. This is public by design.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Jobs (Adzuna) — job listings in occupation detail ──────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── AI (career-path / route-map generation) ─────────────────────────────────
ANTHROPIC_API_KEY=
